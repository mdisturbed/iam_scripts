# Evidence output must never be committed
output/
**/output/
*.csv
*.json
*.log
!docs/**/*.json

# Keys and certificates
*.pfx
*.p12
*.cer
*.pem
*.key

# Local HR or data exports
*export*.*
!tools/**
!scripts/**

# Placeholder input templates are the only CSVs allowed in the repo
!examples/
!examples/*.example.csv

# Editor / OS
.vscode/
.DS_Store
Thumbs.db

# ---- Guardrail (tools/guardrail, docs/guardrail.md) ----
# Private denylist and per-machine settings: never committed
tools/guardrail/denylist.local.txt
*.local.psd1
*.local.json
.env
.env.*
# Credentials
*.cred.xml
*cred*.xml
*.kdbx
secrets.*
# Other data / output
*.tsv
*.xlsx
# The one binary template allowed, pinned by SHA-256 in tools/guardrail/allowed-binaries.txt
!templates/*.template.xlsx
*.xls
*.bak
*.zip
*.7z
*.evtx
# Guardrail CI download
gitleaks
gl.tgz
