#!/bin/sh
# Guardrail: commit messages are public history too - no names, tickets, hosts or emails in them.
root="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then ps=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then ps=powershell.exe
else echo "guardrail: PowerShell not found - refusing commit (fail closed)."; exit 1; fi
"$ps" -NoProfile -ExecutionPolicy Bypass -File "$root/tools/guardrail/Invoke-Guardrail.ps1" -Mode Files -Path "$1" || exit 1
